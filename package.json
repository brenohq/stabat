{
  "name": "stabat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Arranjos da banda para estudar em casa",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "python3 -m unittest discover -s tools/tests -q",
    "e2e": "playwright test",
    "shots": "SHOTS=1 playwright test --project=shots",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:py && npm run build && npm run e2e",
    "publicar": "python3 tools/publicar.py",
    "og": "node tools/og/render.mjs && node tools/og/ritmo.mjs && node tools/og/home.mjs && node tools/og/afinador.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "firebase": "^13.4.0",
    "pdf-lib": "1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "verovio": "6.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
